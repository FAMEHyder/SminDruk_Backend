# ==========================================
# Smindruk Backend - Environment Configuration
# ==========================================
# Copy this file to ".env" and replace every placeholder
# with your own values. NEVER commit the real ".env" file.

# ---------- Server ----------
PORT=8000
NODE_ENV=development

# ---------- URLs: Local (development) ----------
API_URL_LOCAL=http://localhost:8000
FRONTEND_URL_LOCAL=http://localhost:3000

# ---------- URLs: Live (Railway + Vercel) ----------
API_URL_LIVE=https://smindruk.up.railway.app
FRONTEND_URL_LIVE=https://smindruk.vercel.app

# Comma-separated extra CORS origins (both frontends are auto-included)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,https://smindruk.vercel.app,https://dashboard-smindruk.vercel.app
ADMIN_FRONTEND_URL_LIVE=https://dashboard-smindruk.vercel.app

# Legacy fallbacks (optional — LOCAL/LIVE vars above take priority)
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ---------- Database ----------
MONGO_URL=your_mongodb_atlas_connection_string
MONGO_DB_NAME=smindruk

# ---------- Authentication ----------
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# ---------- Encryption (social account tokens at rest) ----------
# Required on Railway. If omitted, JWT_SECRET is used as a fallback.
ENCRYPTION_KEY=a_long_random_passphrase_used_to_encrypt_stored_oauth_tokens

# ---------- OAuth: Facebook ----------
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
FB_CALLBACK_URL=http://localhost:8000/api/v1/auth/facebook/callback
# Instagram uses the same Meta App credentials as Facebook. Register this exact
# callback URL in Meta for Developers under Facebook Login > Valid OAuth Redirect URIs.
INSTAGRAM_CALLBACK_URI=http://localhost:8000/api/v1/social-accounts/instagram/callback

# ---------- OAuth: LinkedIn ----------
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URI=http://localhost:8000/api/v1/social-accounts/linkedin/callback

# ---------- OAuth: Google ----------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# ---------- OAuth: GitHub ----------
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# ---------- Cloudinary (Media Storage) ----------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---------- OpenAI / Groq (AI text module) ----------
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Hugging Face (AI image generation) ----------
HF_TOKEN=hf_your_hugging_face_token
# Optional overrides:
# HF_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-base-4B
# HF_IMAGE_PROVIDER=auto
# HF_IMAGE_TIMEOUT_MS=120000

# ---------- Email (Nodemailer) ----------
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_USER=your_email_username
EMAIL_PASS=your_email_password
EMAIL_FROM=Smindruk <no-reply@smindruk.app>

# ---------- Payments ----------
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ---------- Growth Services / SMM Marketplace ----------
# Keep enabled only while the module is ready for your users. The dummy provider
# and gateway values intentionally never process real orders or payments.
SMM_MODULE_ENABLED=true
SMM_PROVIDER_ENCRYPTION_KEY=replace_with_a_32_byte_random_secret_before_real_provider_use
SMM_PROVIDER_MODE=dummy
# To use SMMZIO set SMM_PROVIDER_MODE=smmzio and add the private key below.
SMMZIO_API_URL=https://smmzio.com/api/v2
SMMZIO_API_KEY=your_smmzio_private_api_key
SMM_PAYMENT_MODE=manual
SMM_API_RATE_LIMIT=60

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------- Scheduler (optional — for Railway external cron backup) ----------
CRON_SECRET=your_random_cron_secret_for_railway_cron_jobs
CRON_TIMEZONE=Asia/Karachi
FB_TOKEN_REFRESH_AFTER_DAYS=45
FB_TOKEN_REFRESH_CRON=0 12 * * *
